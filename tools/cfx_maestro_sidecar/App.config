<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    The binding is configured programmatically in Program.cs (CreateClient), so
    no <system.serviceModel> section is required here. This file exists for the
    .NET Framework runtime header and as the place to add diagnostics if needed.

    To debug the WCF channel (handshake, security, reliable messaging), uncomment
    the trace listeners below and inspect CfxMaestroSidecar.svclog with SvcTraceViewer.
  -->

  <!--
  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel" switchValue="Information, ActivityTracing"
              propagateActivity="true">
        <listeners>
          <add name="sdt" type="System.Diagnostics.XmlWriterTraceListener"
               initializeData="CfxMaestroSidecar.svclog" />
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
  -->
</configuration>
